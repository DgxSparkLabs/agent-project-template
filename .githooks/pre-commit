#!/bin/bash
# Pre-commit hook: build must succeed with zero warnings, test freshness check.
# Install: git config core.hooksPath .githooks

set -uo pipefail

ERRORS=0

# ---------- Build check ----------
# Detect build system, verify both success AND zero warnings.

build_output=""
build_exit=0

if [ -f Makefile ]; then
    build_output=$(make -j"$(nproc)" 2>&1) || build_exit=$?
elif [ -f CMakeLists.txt ] && [ -d build ]; then
    build_output=$(cd build && make -j"$(nproc)" 2>&1) || build_exit=$?
elif [ -f package.json ]; then
    build_output=$(npm run build 2>&1) || build_exit=$?
elif [ -f Cargo.toml ]; then
    build_output=$(cargo build 2>&1) || build_exit=$?
fi

if [ "$build_exit" -ne 0 ]; then
    echo "ERROR: build failed (exit $build_exit). Fix before committing."
    echo "$build_output" | tail -20
    ERRORS=$((ERRORS+1))
elif echo "$build_output" | grep -qi "warning:"; then
    echo "ERROR: build has warnings. Fix before committing."
    echo "$build_output" | grep -i "warning:" | head -10
    ERRORS=$((ERRORS+1))
fi

# ---------- Test freshness nudge ----------
# Warn (don't block) if tests haven't been run recently.

TEST_RUNNER="test/run_tests.sh"
if [ -x "$TEST_RUNNER" ]; then
    # Check if any source file is newer than the test runner's last output
    NEWEST_SRC=$(find . -name '*.c' -o -name '*.rs' -o -name '*.py' -o -name '*.ts' -o -name '*.js' \
        -o -name '*.go' -o -name '*.java' -o -name '*.cpp' -o -name '*.h' 2>/dev/null \
        | head -50 | xargs -r stat -c '%Y' 2>/dev/null | sort -rn | head -1)
    NEWEST_SRC=${NEWEST_SRC:-0}

    # Use a sentinel file to track last test run
    LAST_TEST_RUN=".githooks/.last_test_run"
    if [ -f "$LAST_TEST_RUN" ]; then
        LAST_RUN_TIME=$(stat -c '%Y' "$LAST_TEST_RUN" 2>/dev/null || echo 0)
    else
        LAST_RUN_TIME=0
    fi

    if [ "$NEWEST_SRC" -gt "$LAST_RUN_TIME" ] 2>/dev/null; then
        echo "NOTE: source files changed since last test run. Consider: cd test && ./run_tests.sh"
    fi
fi

[ "$ERRORS" -eq 0 ] && exit 0 || exit 1
