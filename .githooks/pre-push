#!/bin/bash
# Pre-push hook: tests must pass before pushing.
# Install: git config core.hooksPath .githooks

set -uo pipefail

TEST_RUNNER="test/run_tests.sh"

if [ -x "$TEST_RUNNER" ]; then
    echo "Running tests before push..."
    if ! cd test && ./run_tests.sh; then
        echo "ERROR: tests failed. Fix before pushing."
        exit 1
    fi
fi

exit 0
